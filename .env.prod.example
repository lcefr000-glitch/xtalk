# Copy to .env.prod and fill in. Never commit .env.prod.
# Generate secrets with:  openssl rand -hex 32

# Public hostname that points (DNS A record) at your server, e.g. api.yourdomain.com
DOMAIN=api.example.com
ACME_EMAIL=you@example.com

POSTGRES_USER=xtalk
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=xtalk

NODE_ENV=production
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MIN_AGE=13
DEV_EXPOSE_TOKENS=false

# Optional: first admin account (created by the seed command)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional features (endpoints return 503 until configured)
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
CORRECT_BASE_URL=
AI_TUTOR_BASE_URL=
AI_TUTOR_API_KEY=
AI_TUTOR_MODEL=gpt-4o-mini
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# CORS_ORIGINS=https://yourweb.example

# Live voice (LiveKit Cloud or self-hosted). Without these, joining a room works but audio returns 503.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
