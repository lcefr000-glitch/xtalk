# Server
NODE_ENV=development
PORT=3000
APP_NAME=X TaIk

# Database (matches ../docker-compose.yml)
DATABASE_URL=postgresql://xtalk:xtalk_dev_password@localhost:5432/xtalk?schema=public

# Redis (reserved for caching / rate-limit storage in later phases)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Minimum registration age (years)
MIN_AGE=13

# Dev only: log email-verification / password-reset tokens instead of sending mail
DEV_EXPOSE_TOKENS=true

# Providers (Phase 4). All optional; endpoints return 503 until configured.
TRANSLATE_BASE_URL=            # LibreTranslate-compatible, e.g. http://localhost:5000
TRANSLATE_API_KEY=
CORRECT_BASE_URL=              # LanguageTool-compatible, e.g. http://localhost:8010
AI_TUTOR_BASE_URL=             # OpenAI-compatible base, e.g. https://api.openai.com
AI_TUTOR_API_KEY=
AI_TUTOR_MODEL=gpt-4o-mini

# Google Play Billing (Phase 7) - service account JSON, optional
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# First admin bootstrap (used by prisma:seed when both set)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Live voice (LiveKit Cloud or self-hosted). Without these, joining a room works but audio returns 503.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
